---
import type { CollectionEntry } from "astro:content";
import { categoryLabels } from "../lib/category-labels";

interface Props {
  product: CollectionEntry<"products">;
  variant?: "catalog" | "featured";
}

const { product, variant = "catalog" } = Astro.props;
const { name, category, description, image, imageAlt, price } = product.data;
const categoryTitle = categoryLabels[category]?.title ?? category.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
---

<article class:list={["content-card", "product-card", `product-card-${variant}`]}>
  {image ? (
    <a class="product-image-link" href={`/products/${product.id}/`} aria-label={`View ${name}`}>
      <img src={image} alt={imageAlt ?? name} loading="lazy" />
    </a>
  ) : (
    <div class="product-image-placeholder" aria-hidden="true">
      <span>{categoryTitle}</span>
      <small>Product image not provided</small>
    </div>
  )}
  <div class="card-content">
    <p class="card-category">{categoryTitle}</p>
    <h3><a href={`/products/${product.id}/`}>{name}</a></h3>
    <p class="card-description">{description}</p>
    {price && <p class="price">{price}</p>}
    <a class="card-link" href={`/products/${product.id}/`}>View product <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .product-card { display: flex; flex-direction: column; }
  .product-image-placeholder { display: flex; min-height: 9rem; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem; padding: 1.25rem; background: linear-gradient(135deg, var(--mist), #f7f4e8); color: var(--teal-deep); text-align: center; text-transform: capitalize; }
  .product-image-placeholder span { font-family: var(--heading-font); font-size: 1.2rem; font-weight: 800; }
  .product-image-placeholder small { color: var(--muted-ink); font-size: 0.8rem; }
  .product-image-link { display: grid; place-items: center; overflow: hidden; width: 100%; aspect-ratio: 4 / 3; background: linear-gradient(145deg, var(--mist), #f6f3e8); }
  .product-image-link img { display: block; width: 100%; height: 100%; padding: clamp(0.75rem, 2vw, 1.25rem); object-fit: contain; }
  .product-card .card-content { flex: 1; }
  .product-card .card-link { margin-top: auto; }
  .price { margin: 0 0 0.65rem; color: var(--teal-deep); font-size: 1.05rem; font-weight: 800; }
  @media (min-width: 1000px) {
    .product-card-featured { display: grid; grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr); align-items: stretch; }
    .product-card-featured .product-image-link { align-self: center; aspect-ratio: 4 / 3; }
  }
</style>
