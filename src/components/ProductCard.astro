---
import type { CollectionEntry } from "astro:content";

interface Props {
  product: CollectionEntry<"products">;
  variant?: "catalog" | "featured";
}

const { product, variant = "catalog" } = Astro.props;
const { name, category, description, image, imageAlt, price } = product.data;
const categoryTitle = category.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
---

<article class:list={["content-card", "product-card", `product-card-${variant}`]}>
  <a class="product-image-link" href={`/products/${product.id}/`} aria-label={`View ${name}`}>
    <img src={image ?? "/images/feeder-illustration.svg"} alt={imageAlt ?? name} loading="lazy" />
  </a>
  <div class="card-content">
    <p class="card-category">{categoryTitle}</p>
    <h3><a href={`/products/${product.id}/`}>{name}</a></h3>
    <p class="card-description">{description}</p>
    {price && <p class="price">{price}</p>}
    <a class="card-link" href={`/products/${product.id}/`}>View product <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .product-card { display: flex; flex-direction: column; }
  .product-image-link { display: grid; place-items: center; overflow: hidden; width: 100%; aspect-ratio: 4 / 3; background: var(--mist); }
  .product-image-link img { display: block; width: 100%; height: 100%; padding: 0.75rem; object-fit: contain; }
  .product-card .card-content { flex: 1; }
  .product-card .card-link { margin-top: auto; }
  .price { margin: 0 0 0.65rem; color: var(--teal-deep); font-size: 1.05rem; font-weight: 800; }
  @media (min-width: 1000px) {
    .product-card-featured { display: grid; grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.66fr); align-items: stretch; }
    .product-card-featured .product-image-link { align-self: center; aspect-ratio: 4 / 3; }
  }
</style>
