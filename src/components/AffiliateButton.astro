---
interface Props {
  url: string;
  label?: string;
}

const { url, label = "Check price" } = Astro.props;
---

<a class="affiliate-button" href={url} target="_blank" rel="sponsored nofollow noopener">{label}</a>

<style>
  .affiliate-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--button-height);
    padding: 0.55rem 0.9rem;
    border: 2px solid var(--ink);
    border-radius: var(--control-radius);
    background: var(--sun);
    color: var(--ink);
    font-size: var(--button-font-size);
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .affiliate-button:hover {
    background: var(--sun-deep);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .affiliate-button { transition: none; }
    .affiliate-button:hover { transform: none; }
  }
</style>
