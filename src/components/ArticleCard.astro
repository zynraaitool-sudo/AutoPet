---
import type { CollectionEntry } from "astro:content";

interface Props {
  article: CollectionEntry<"reviews">;
}

const { article } = Astro.props;
const { title, description, date, category, image, imageAlt, articleType } = article.data;
const categoryTitle = category.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
const typeTitle = articleType?.replaceAll("-", " ");
---

<article class="content-card article-card">
  <a class="article-image-link" href={`/reviews/${article.id}/`} aria-label={`Read ${title}`}>
    <img src={image ?? "/images/feeder-illustration.svg"} alt={imageAlt ?? title} loading="lazy" />
  </a>
  <div class="card-content">
    <div class="article-meta">
      <p class="card-category">{categoryTitle}</p>
      <time datetime={date.toISOString()}>{date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
    </div>
    {typeTitle && <p class="article-type">{typeTitle}</p>}
    <h3><a href={`/reviews/${article.id}/`}>{title}</a></h3>
    <p class="card-description">{description}</p>
    <a class="card-link" href={`/reviews/${article.id}/`}>Read article <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .article-card { display: flex; flex-direction: column; }
  .article-image-link { position: relative; display: block; overflow: hidden; width: 100%; height: clamp(150px, 42vw, 180px); background: var(--mist); }
  .article-image-link img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 180ms ease; }
  .article-card:hover .article-image-link img { transform: scale(1.025); }
  .article-meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.25rem 0.65rem; width: 100%; }
  .article-meta time { color: var(--muted-ink); font-size: 0.78rem; }
  .article-type { margin: 0.35rem 0 0; color: var(--muted-ink); font-size: 0.76rem; text-transform: capitalize; }
  @media (min-width: 1000px) {
    .article-card { display: grid; grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.66fr); }
    .article-image-link { height: auto; min-height: 190px; }
  }
  @media (prefers-reduced-motion: reduce) { .article-image-link img { transition-duration: 0.01ms; } }
</style>
