---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

{faqs.length > 0 && (
  <>
    <div class="faqs">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </>
)}

<style>
  .faqs { border-top: 1px solid var(--line); }
  details { padding: 1rem 0; border-bottom: 1px solid var(--line); }
  summary { color: var(--ink); font-weight: 700; cursor: pointer; }
  summary:focus-visible { outline: 3px solid var(--teal); outline-offset: 4px; }
  p { max-width: 68ch; margin-bottom: 0; color: var(--muted-ink); }
</style>
