---
interface Props {
  title: string;
  description: string;
  canonical?: string | false;
  type?: "website" | "article";
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  type = "website",
  image,
  imageAlt,
  noindex = false,
} = Astro.props;
const canonicalUrl = canonical === false
  ? false
  : canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const absoluteImage = new URL(image ?? "/images/autopet-cat-feeder-guide-optimized.webp", Astro.site ?? Astro.url).href;
const absoluteImageAlt = imageAlt ?? title;
const siteUrl = Astro.site?.href ?? new URL("/", Astro.url).href;
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "AutoPet",
      url: siteUrl,
      logo: new URL("/favicon.svg", siteUrl).href,
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "AutoPet",
      url: siteUrl,
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager - AutoPet -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-W6PNNTSK');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AutoPet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={absoluteImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={absoluteImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
    <meta name="theme-color" content="#123f43" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W6PNNTSK"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="AutoPet home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" focusable="false">
              <ellipse cx="9" cy="10" rx="3.1" ry="4.3" transform="rotate(-28 9 10)" />
              <ellipse cx="16" cy="7.5" rx="3.1" ry="4.3" />
              <ellipse cx="23" cy="10" rx="3.1" ry="4.3" transform="rotate(28 23 10)" />
              <path d="M16 14c-4.8 0-9.2 4.1-9.2 8.1 0 2.8 2.4 4.2 5 3.2 2.8-1 5.6-1 8.4 0 2.6 1 5-.4 5-3.2C25.2 18.1 20.8 14 16 14Z" />
            </svg>
          </span><span>AutoPet</span>
        </a>
        <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false">
          <span class="menu-toggle-label">Menu</span>
          <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
        </button>
        <nav class="primary-nav" id="primary-navigation" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/products/">Browse Products</a>
          <a href="/reviews/">Reviews &amp; Guides</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a class="footer-brand" href="/">AutoPet</a>
          <p>Clear-eyed reviews for better days with pets.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/terms/">Terms</a>
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
        </nav>
        <small>© {new Date().getFullYear()} AutoPet. Independent product guides for pet people.</small>
      </div>
    </footer>
  </body>
</html>

<script>
  const header = document.querySelector(".site-header");
  const menuToggle = document.querySelector(".menu-toggle");
  const primaryNav = document.querySelector(".primary-nav");

  if (header instanceof HTMLElement && menuToggle instanceof HTMLButtonElement && primaryNav instanceof HTMLElement) {
    header.dataset.menuReady = "true";
    header.dataset.menuOpen = "false";

    const closeMenu = () => {
      header.dataset.menuOpen = "false";
      menuToggle.setAttribute("aria-expanded", "false");
    };

    menuToggle.addEventListener("click", () => {
      const isOpen = header.dataset.menuOpen === "true";
      header.dataset.menuOpen = String(!isOpen);
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
    });

    primaryNav.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.dataset.menuOpen === "true") {
        closeMenu();
        menuToggle.focus();
      }
    });
  }
</script>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #263b32;
    --muted-ink: #52665c;
    --teal: #3c725b;
    --teal-deep: #244b3a;
    --sun: #f3c95b;
    --sun-deep: #d7a833;
    --paper: #fffdf7;
    --mist: #e8efe7;
    --line: #d4dfd4;
    --site-content-width: 1200px;
    --site-content-gutter: clamp(1rem, 3vw, 1.5rem);
    --page-block-space: clamp(2rem, 4vw, 3.25rem);
    --section-block-space: clamp(2rem, 3.75vw, 3.25rem);
    --card-radius: 0.85rem;
    --card-shadow: 0 8px 24px rgb(38 59 50 / 6%);
    --card-shadow-hover: 0 14px 30px rgb(38 59 50 / 11%);
    --card-padding: clamp(1rem, 1.6vw, 1.25rem);
    --control-radius: 0.5rem;
    --button-height: 2.75rem;
    --button-font-size: 0.9rem;
    --heading-font: "Trebuchet MS", "Avenir Next", sans-serif;
    --body-font: "Segoe UI", "Helvetica Neue", sans-serif;
    font-family: var(--body-font);
    color: var(--ink);
    background: #fbfaf4;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; line-height: 1.65; }
  a { color: var(--teal); }
  a:hover { color: var(--teal-deep); }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--sun-deep); outline-offset: 4px; }
  h1, h2, h3 { font-family: var(--heading-font); line-height: 1.15; letter-spacing: -0.025em; }
  h1 { font-size: clamp(2.1rem, 5vw, 3.75rem); }
  h2 { font-size: clamp(1.55rem, 3vw, 2.25rem); }
  p { max-width: 70ch; }
  img, video, iframe { max-width: 100%; }
  .page-shell { width: 100%; max-width: var(--site-content-width); padding: var(--page-block-space) var(--site-content-gutter); margin-inline: auto; }
  .eyebrow { margin: 0 0 0.6rem; color: var(--teal); font-size: 0.78rem; font-weight: 750; letter-spacing: 0.09em; text-transform: uppercase; }
  .page-heading { max-width: 760px; }
  .page-heading h1 { margin: 0; }
  .intro { color: var(--muted-ink); font-size: clamp(1rem, 1.5vw, 1.1rem); }
  .content-card { overflow: hidden; min-width: 0; border: 1px solid var(--line); border-radius: var(--card-radius); background: var(--paper); box-shadow: var(--card-shadow); transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease; }
  .content-card:hover { transform: translateY(-2px); border-color: #9bb9af; box-shadow: var(--card-shadow-hover); }
  .content-card .card-content { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; padding: var(--card-padding); }
  .content-card .card-category { margin: 0; color: var(--teal); font-size: 0.75rem; font-weight: 750; letter-spacing: 0.055em; text-transform: uppercase; }
  .content-card h3 { margin: 0.55rem 0; font-size: clamp(1.08rem, 1.5vw, 1.3rem); line-height: 1.25; overflow-wrap: anywhere; }
  .content-card h3 a { color: var(--ink); text-decoration: none; text-underline-offset: 4px; }
  .content-card h3 a:hover { color: var(--teal); text-decoration: underline; }
  .content-card .card-description { display: -webkit-box; overflow: hidden; margin: 0 0 0.75rem; color: var(--muted-ink); font-size: 0.92rem; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .content-card .card-link { display: inline-flex; min-height: var(--button-height); align-items: center; gap: 0.45rem; margin-top: 0.15rem; padding: 0.55rem 0.9rem; border-radius: var(--control-radius); background: var(--sun); color: var(--teal-deep); font-size: var(--button-font-size); font-weight: 750; text-decoration: none; transition: background-color 140ms ease, color 140ms ease; }
  .content-card .card-link:hover { background: var(--teal-deep); color: var(--paper); }
  .empty-state { padding: clamp(1.15rem, 2.5vw, 1.75rem); border: 1px solid var(--line); border-left: 4px solid var(--sun-deep); border-radius: var(--card-radius); background: linear-gradient(110deg, var(--mist), var(--paper)); color: var(--muted-ink); }
  .empty-state h2 { margin: 0 0 0.4rem; color: var(--ink); font-size: clamp(1.25rem, 2vw, 1.6rem); }
  .empty-state p { margin: 0.35rem 0; }
  .empty-state .empty-kicker { color: var(--teal); font-size: 0.74rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  .empty-action { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.65rem; color: var(--teal-deep); font-weight: 750; text-underline-offset: 3px; }
  .empty-action:hover { color: var(--teal); }
  input, select { min-height: 2.75rem; padding: 0.5rem 0.7rem; border: 1px solid var(--line); border-radius: var(--control-radius); background: var(--paper); color: var(--ink); font: inherit; }
  input:focus-visible, select:focus-visible { border-color: var(--teal); outline: 3px solid rgb(24 91 93 / 16%); outline-offset: 1px; }
  .skip-link { position: absolute; top: 0.5rem; left: 0.5rem; z-index: 20; padding: 0.7rem 1rem; background: var(--paper); transform: translateY(-150%); }
  .skip-link:focus { transform: translateY(0); }
  .site-header { position: relative; z-index: 5; border-bottom: 1px solid var(--line); background: var(--paper); }
  .header-inner, .footer-inner { width: 100%; max-width: var(--site-content-width); padding-inline: var(--site-content-gutter); margin-inline: auto; }
  .header-inner { min-height: 4.75rem; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--ink); font-family: var(--heading-font); font-size: 1.45rem; font-weight: 800; text-decoration: none; }
  .brand-mark { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 0.75rem; background: var(--sun); color: var(--teal-deep); }
  .brand-mark svg { width: 1.3rem; fill: currentColor; }
  .primary-nav { display: flex; align-items: center; gap: 0.35rem; }
  .primary-nav a { padding: 0.55rem 0.8rem; border-radius: var(--control-radius); color: var(--ink); font-size: var(--button-font-size); font-weight: 650; text-decoration: none; transition: background-color 140ms ease, color 140ms ease; }
  .primary-nav a:hover { background: var(--mist); color: var(--teal-deep); }
  .menu-toggle { display: none; min-height: var(--button-height); align-items: center; gap: 0.65rem; padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: var(--control-radius); background: var(--paper); color: var(--ink); font: inherit; font-size: var(--button-font-size); font-weight: 700; cursor: pointer; }
  .menu-icon { display: grid; gap: 4px; }
  .menu-icon span { display: block; width: 1rem; height: 2px; background: currentColor; }
  main { min-height: 60vh; }
  .site-footer { margin-top: var(--section-block-space); background: var(--teal-deep); color: var(--paper); }
  .footer-inner { display: grid; grid-template-columns: 1fr; gap: 1.25rem; padding-block: 2.25rem; }
  .footer-brand { color: var(--sun); font-family: var(--heading-font); font-size: 1.5rem; font-weight: 800; text-decoration: none; }
  .footer-inner p { margin: 0.3rem 0; color: #e0eeea; }
  .footer-inner nav { display: flex; flex-wrap: wrap; gap: 0.75rem 1.35rem; }
  .footer-inner nav a { color: var(--paper); text-underline-offset: 4px; }
  .footer-inner nav a:hover { color: var(--sun); }
  .footer-inner small { color: #d1e1dc; }
  @media (min-width: 720px) {
    .footer-inner { grid-template-columns: 1fr 1.5fr; align-items: center; }
    .footer-inner small { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .header-inner { position: relative; min-height: 4.6rem; }
    .menu-toggle { display: inline-flex; }
    .primary-nav { display: flex; flex-direction: column; align-items: stretch; gap: 0; padding-block: 0.25rem 0.75rem; }
    .primary-nav a { padding: 0.8rem 0.25rem; border-top: 1px solid var(--line); }
    .site-header[data-menu-ready="true"] .primary-nav { display: none; }
    .site-header[data-menu-ready="true"][data-menu-open="true"] .primary-nav { display: flex; }
    .header-inner { flex-wrap: wrap; }
    .primary-nav { flex: 0 0 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
  }
</style>
