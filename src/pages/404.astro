---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found | AutoPet" description="The page you're looking for could not be found." canonical={false} noindex>
  <section class="not-found">
    <p class="eyebrow">404 · No page here</p>
    <h1>Looks like this trail went somewhere else.</h1>
    <p>The page may have moved or the link may be mistyped. Let's get you back to useful pet advice.</p>
    <a href="/">Return to AutoPet home</a>
  </section>
</SiteLayout>
<style>
  .not-found { width: min(720px, calc(100% - 2rem)); margin: auto; padding-block: clamp(4rem, 14vw, 9rem); }
  .eyebrow { color: var(--teal); font-weight: 750; }
  h1 { max-width: 12ch; }
  .not-found > a { display: inline-block; margin-top: 1rem; padding: 0.7rem 1rem; background: var(--sun); color: var(--ink); font-weight: 750; }
</style>
