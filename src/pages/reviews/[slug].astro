---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductTable from "../../components/ProductTable.astro";
import ProsCons from "../../components/ProsCons.astro";
import FAQSection from "../../components/FAQSection.astro";

export async function getStaticPaths() {
  const reviews = await getCollection("reviews", ({ data }) => !data.draft);
  return reviews.map((review) => ({ params: { slug: review.id }, props: { review } }));
}

const { review } = Astro.props;
const { Content } = await render(review);
const { title, description, date, updated, category, image, imageAlt, quickVerdict, products, pros, cons, faqs } = review.data;
const categoryLabels: Record<string, string> = {
  "automatic-cat-feeders": "Automatic cat feeders",
  "pet-water-fountains": "Pet water fountains",
  "smart-litter-boxes": "Smart litter boxes",
};
const categoryLabel = categoryLabels[category] ?? category;
const isoDate = date.toISOString();
const isoUpdated = (updated ?? date).toISOString();
const readingMinutes = Math.max(1, Math.ceil(review.body.split(/\s+/).length / 220));
const canonical = new URL(`/reviews/${review.id}/`, Astro.site).href;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: isoDate,
  dateModified: isoUpdated,
  author: { "@type": "Organization", name: "AutoPet" },
  publisher: { "@type": "Organization", name: "AutoPet", url: Astro.site?.href },
  mainEntityOfPage: canonical,
};
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  name: title,
  reviewBody: quickVerdict || undefined,
  datePublished: isoDate,
  dateModified: isoUpdated,
  author: { "@type": "Organization", name: "AutoPet" },
  itemReviewed: products.map((product) => ({ "@type": "Product", name: product.name })),
};
---

<SiteLayout title={`${title} | AutoPet`} description={description} canonical={canonical} type="article">
  <article class="article-shell">
    {image && <img class="featured-image" src={image} width="1200" height="675" loading="lazy" alt={imageAlt ?? title} />}
    <header class="article-header">
      <a class="back-link" href={`/category/${category.toLowerCase().replaceAll(" ", "-")}/`}>← {categoryLabel}</a>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <div class="meta">
        <span>Published <time datetime={isoDate}>{date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time></span>
        <span>Updated <time datetime={isoUpdated}>{(updated ?? date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time></span>
        <span>{readingMinutes} min read</span>
      </div>
      <p class="disclosure">This article contains affiliate links. If you buy through them, AutoPet may earn a commission at no extra cost to you. <a href="/affiliate-disclosure/">How our links work</a>.</p>
    </header>

    <div class="article-content">
      {quickVerdict && (
        <aside class="verdict" aria-labelledby="verdict-title">
          <span class="verdict-mark" aria-hidden="true">✓</span>
          <div><h2 id="verdict-title">Quick verdict</h2><p>{quickVerdict}</p></div>
        </aside>
      )}

      {products.length > 0 && (
        <section aria-labelledby="comparison-heading">
          <h2 id="comparison-heading">Compare our top picks</h2>
          <ProductTable products={products} />
        </section>
      )}

      {(pros.length > 0 || cons.length > 0) && (
        <section aria-labelledby="pros-cons-heading">
          <h2 id="pros-cons-heading">The short version</h2>
          <ProsCons pros={pros} cons={cons} />
        </section>
      )}

      <div class="prose"><Content /></div>

      {faqs.length > 0 && (
        <section aria-labelledby="faq-heading">
          <h2 id="faq-heading">Frequently asked questions</h2>
          <FAQSection faqs={faqs} />
        </section>
      )}
      <p class="last-reviewed">Product details checked on <time datetime={isoUpdated}>{(updated ?? date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>. Prices and availability can change.</p>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)}></script>
</SiteLayout>

<style>
  .article-shell { width: min(1120px, calc(100% - 2rem)); margin: auto; padding-block: 2.5rem 1rem; }
  .featured-image { display: block; width: min(100%, 1000px); height: auto; aspect-ratio: 16 / 9; margin: 0 auto 2rem; object-fit: cover; }
  .article-header { max-width: 780px; margin: auto; }
  .back-link { font-size: 0.9rem; font-weight: 700; }
  h1 { max-width: 16ch; margin: 1rem 0; font-size: clamp(2.5rem, 7vw, 4.5rem); }
  .dek { color: var(--muted-ink); font-size: 1.2rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; color: var(--muted-ink); font-size: 0.9rem; }
  .disclosure { margin-top: 1.1rem; padding: 0.8rem 1rem; background: var(--mist); font-size: 0.91rem; }
  .article-content { max-width: 850px; margin: 2rem auto; }
  .article-content section { margin-top: 3rem; }
  .article-content section > h2 { margin-bottom: 1rem; }
  .verdict { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.3rem; border-left: 5px solid var(--sun-deep); background: #f8f3df; }
  .verdict-mark { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--teal); color: white; font-weight: 800; }
  .verdict h2 { margin: 0; font-size: 1.4rem; }
  .verdict p { margin: 0.35rem 0 0; }
  .prose { margin-top: 3rem; }
  .prose :global(h2) { margin-top: 2.4rem; }
  .prose :global(h3) { margin-top: 1.8rem; }
  .prose :global(p), .prose :global(li) { max-width: 70ch; color: #314b4c; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(.raw-html) { max-width: 100%; overflow-x: auto; }
  .prose :global(.raw-html img) { max-width: 100%; height: auto; }
  .prose :global(.raw-html table) { width: 100%; border-collapse: collapse; text-align: left; }
  .prose :global(.raw-html th), .prose :global(.raw-html td) { padding: 0.75rem; border: 1px solid var(--line); vertical-align: top; }
  .prose :global(.raw-html th) { background: var(--teal); color: var(--paper); }
  .prose :global(.affiliate-button) { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; padding: 0.65rem 1rem; border: 2px solid var(--ink); background: var(--sun); color: var(--ink); font-weight: 750; text-decoration: none; }
  .prose :global(.callout) { margin-block: 1.5rem; padding: 1rem 1.2rem; border-left: 4px solid var(--teal); background: var(--mist); }
  .prose :global(.callout p) { margin: 0; }
  .prose :global(.callout-warning) { border-left-color: var(--sun-deep); background: #f8f3df; }
  .last-reviewed { margin-top: 3rem; color: var(--muted-ink); font-size: 0.9rem; }
</style>
