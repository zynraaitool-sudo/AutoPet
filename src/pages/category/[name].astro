---
import { getCollection } from "astro:content";
import ProductCard from "../../components/ProductCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const labels: Record<string, { title: string; description: string }> = {
  "automatic-cat-feeders": {
    title: "Automatic cat feeders",
    description: "Independent guides to automatic cat feeders, portion control, scheduling, and everyday reliability.",
  },
  "pet-water-fountains": {
    title: "Pet water fountains",
    description: "Practical advice on pet water fountains, filtration, cleaning, and the features worth paying for.",
  },
  "smart-litter-boxes": {
    title: "Smart litter boxes",
    description: "Compare smart litter boxes with an eye on safety, cleanup, setup, and ongoing costs.",
  },
  "pet-enrichment": {
    title: "Pet enrichment",
    description: "Explore play and resting accessories, with practical checks for fit, stability, materials, and supervision.",
  },
  "pet-feeding-accessories": {
    title: "Pet feeding accessories",
    description: "Compare feeding accessories and verify sizing, materials, cleaning instructions, and seller claims.",
  },
  "pet-safety-accessories": {
    title: "Pet safety accessories",
    description: "Review pet safety accessories with attention to fit, limitations, and what the technology can—and cannot—do.",
  },
  "pet-inspired-toys": {
    title: "Pet-inspired toys for children",
    description: "Children's toys inspired by pets. These products are not pet-care equipment or toys intended for animals.",
  },
  "pet-grooming": {
    title: "Pet grooming",
    description: "Compare seller-listed grooming tools and check their intended use, size, and care instructions.",
  },
  "dog-walking-travel": {
    title: "Dog walking and travel",
    description: "Review seller-listed walking and travel accessories, with attention to sizing, fit, and product limitations.",
  },
  "interactive-cat-toys": {
    title: "Interactive cat toys",
    description: "Compare interactive play products and check age, parts, charging, and supervision guidance.",
  },
};

export function getStaticPaths() {
  return [
    { params: { name: "automatic-cat-feeders" } },
    { params: { name: "pet-water-fountains" } },
    { params: { name: "smart-litter-boxes" } },
    { params: { name: "pet-enrichment" } },
    { params: { name: "pet-feeding-accessories" } },
    { params: { name: "pet-safety-accessories" } },
    { params: { name: "pet-inspired-toys" } },
    { params: { name: "pet-grooming" } },
    { params: { name: "dog-walking-travel" } },
    { params: { name: "interactive-cat-toys" } },
  ];
}

const { name } = Astro.params;
const category = labels[name ?? ""] ?? {
  title: "Pet gear",
  description: "Independent, practical reviews of smart pet gear.",
};
const reviews = (await getCollection("reviews", ({ data }) => !data.draft && data.category.toLowerCase().replaceAll(" ", "-") === name))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const products = (await getCollection("products", ({ data }) => !data.draft && data.category === name))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder || a.data.name.localeCompare(b.data.name));
---

<SiteLayout title={`${category.title} | AutoPet`} description={category.description}>
  <section class="category-page">
    <a href="/" class="back-link">← AutoPet home</a>
    <p class="eyebrow">Browse category</p>
    <h1>{category.title}</h1>
    <p class="intro">{category.description}</p>
    {products.length > 0 && (
      <section class="category-products" aria-labelledby="category-products-heading">
        <h2 id="category-products-heading">Products in this category</h2>
        <div class="product-grid">
          {products.map((product) => <ProductCard product={product} />)}
        </div>
      </section>
    )}
    {reviews.length > 0 ? (
      <div class="review-list">
        {reviews.map((review) => (
          <article>
            <div><p class="date"><time datetime={review.data.date.toISOString()}>{review.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time></p>
              <h2><a href={`/reviews/${review.id}/`}>{review.data.title}</a></h2>
              <p>{review.data.description}</p>
            </div>
            <a class="read-link" href={`/reviews/${review.id}/`}>Read review <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    ) : reviews.length === 0 && products.length === 0 ? (
      <div class="empty-state"><p>No products or guides are published in this category yet. Browse <a href="/products/">available product listings</a> or return when new research is available.</p></div>
    ) : null}
  </section>
</SiteLayout>

<style>
  .category-page { width: min(var(--site-content-width), calc(100% - 2 * var(--site-content-gutter))); margin: auto; padding-block: var(--page-block-space); }
  .back-link { font-size: 0.9rem; font-weight: 700; }
  .eyebrow { margin: 2rem 0 0.4rem; color: var(--teal); font-weight: 750; }
  h1 { margin: 0; }
  .intro { color: var(--muted-ink); font-size: 1.15rem; }
  .review-list { margin-top: 2rem; border-top: 1px solid var(--line); }
  .review-list article { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--card-radius); background: var(--paper); box-shadow: var(--card-shadow); }
  .review-list { display: grid; gap: 0.8rem; margin-top: 2rem; }
  article h2 { margin: 0.2rem 0; font-size: 1.5rem; }
  article h2 a { color: var(--ink); text-decoration: none; }
  article p { margin: 0.3rem 0; color: var(--muted-ink); }
  .date { font-size: 0.88rem; }
  .read-link { font-weight: 750; white-space: nowrap; }
  .empty-state { margin-top: 2rem; padding: 1.5rem; border-left: 4px solid var(--sun-deep); border-radius: var(--card-radius); background: var(--mist); }
  .category-products { margin-top: 2rem; }
  .product-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  @media (min-width: 700px) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
