---
import { getCollection } from "astro:content";
import ProductCard from "../components/ProductCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const reviews = (await getCollection("reviews", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestReviews = reviews.slice(0, 6);
const featuredProducts = (await getCollection("products", ({ data }) => !data.draft && data.catalogVisible))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder || a.data.name.localeCompare(b.data.name))
  .slice(0, 4);
const categories = [
  { name: "Automatic Cat Feeders", slug: "automatic-cat-feeders", note: "Compare seller-listed feeding features" },
  { name: "Pet Water Fountains", slug: "pet-water-fountains", note: "Explore current listing details" },
  { name: "Pet Grooming", slug: "pet-grooming", note: "Tools for everyday coat care" },
  { name: "Pet Walking & Travel", slug: "pet-walking-travel", note: "Find the right fit for walks and trips" },
  { name: "Interactive Cat Toys", slug: "interactive-cat-toys", note: "Compare enrichment and play products" },
];

---

<SiteLayout
  title="AutoPet | Thoughtful reviews for smarter pet care"
  description="Transparent research and practical guides for comparing pet-care products and their seller-listed features."
  image="/images/autopet-cat-feeder-guide-optimized.webp"
  imageAlt="Automatic cat feeder guide illustration"
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Practical gear. Happier routines.</p>
      <h1>Better Pet Care Starts With <span>Smarter Choices.</span></h1>
      <p class="intro">Clear product research and practical guides to help you compare pet-care products and verify seller claims.</p>
      <a class="button-link" href="/products/">Browse Pet Products <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-art">
      <span class="art-note">Made for real-life routines</span>
      <img src="/images/feeder-illustration.svg" alt="Illustration of a cat beside an automatic feeder" width="520" height="420" fetchpriority="high" />
    </div>
  </section>

  <section class="section-shell featured-section" id="featured-products" aria-labelledby="featured-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">AliExpress product listings</p>
        <h2 id="featured-heading">Featured products</h2>
      </div>
      <a class="text-link section-browse-link" href="/products/">Browse All Products <span aria-hidden="true">→</span></a>
    </div>
    {featuredProducts.length > 0 ? (
      <div class="product-grid">
        {featuredProducts.map((product) => <ProductCard product={product} variant="featured" />)}
      </div>
    ) : (
      <div class="empty-state featured-empty">
        <div>
          <p class="empty-kicker">Thoughtful picks, never guesswork</p>
          <p class="empty-title">Our product picks are coming soon.</p>
          <p>We're carefully reviewing pet products before recommending them. Explore the categories we're researching.</p>
        </div>
        <a class="empty-action" href="#categories">Explore Pet Categories <span aria-hidden="true">→</span></a>
      </div>
    )}
  </section>

  <section class="categories-section" id="categories" aria-labelledby="categories-heading">
    <div class="section-shell">
      <p class="eyebrow">Browse by need</p>
      <h2 id="categories-heading">Thoughtful tech for everyday pet care</h2>
      <div class="category-grid">
        {categories.map((category, index) => (
          <a class="category-card" href={`/category/${category.slug}/`}>
            <span class="category-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" focusable="false">
                <ellipse cx="9" cy="10" rx="3.1" ry="4.3" transform="rotate(-28 9 10)" />
                <ellipse cx="16" cy="7.5" rx="3.1" ry="4.3" />
                <ellipse cx="23" cy="10" rx="3.1" ry="4.3" transform="rotate(28 23 10)" />
                <path d="M16 14c-4.8 0-9.2 4.1-9.2 8.1 0 2.8 2.4 4.2 5 3.2 2.8-1 5.6-1 8.4 0 2.6 1 5-.4 5-3.2C25.2 18.1 20.8 14 16 14Z" />
              </svg>
            </span>
            <span class="category-number">0{index + 1}</span>
            <span class="category-copy">
              <strong>{category.name}</strong>
              <small>{category.note}</small>
            </span>
            <span class="category-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell reviews-section" aria-labelledby="latest-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research without the noise</p>
        <h2 id="latest-heading">Latest Reviews &amp; Guides</h2>
      </div>
      <a class="text-link" href="/reviews/">All Reviews &amp; Guides <span aria-hidden="true">→</span></a>
    </div>
    {latestReviews.length > 0 ? (
      <div class="review-grid">
        {latestReviews.map((article) => <ArticleCard article={article} />)}
      </div>
    ) : (
      <div class="empty-state reviews-empty">
        <p class="empty-kicker">Research before recommendations</p>
        <p class="empty-title">No published reviews or guides just yet.</p>
        <p>We’re verifying every guide before it goes live.</p>
        <a class="empty-action" href="/reviews/">Browse Reviews &amp; Guides <span aria-hidden="true">→</span></a>
      </div>
    )}
  </section>

  <section class="trust-section" aria-labelledby="trust-heading">
    <div class="section-shell trust-inner">
      <div>
        <p class="eyebrow">Our promise to you</p>
        <h2 id="trust-heading">Independent research.<br />Honest comparisons.<br />Practical recommendations.</h2>
      </div>
      <div class="trust-links">
        <p>Clear information helps you find the right fit for your home, your pet, and your routine.</p>
        <a href="/about/">How we work <span aria-hidden="true">→</span></a>
        <a href="/affiliate-disclosure/">Our affiliate disclosure <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { display: grid; align-items: center; gap: clamp(1.75rem, 4vw, 3.5rem); width: calc(100% - 2 * var(--site-content-gutter)); max-width: calc(var(--site-content-width) - 2 * var(--site-content-gutter)); padding: clamp(1.5rem, 4vw, 3.25rem); margin: clamp(1rem, 2.5vw, 2rem) auto; border: 1px solid #e4e9dc; border-radius: calc(var(--card-radius) + 0.35rem); background: linear-gradient(125deg, #f1f4eb 0%, #fbf8ee 100%); }
  .hero-copy { max-width: 630px; }
  h1 { max-width: 13ch; margin: 0; font-size: clamp(2.2rem, 4vw, 3.5rem); }
  h1 span { color: var(--teal); }
  .intro { max-width: 52ch; margin-block: 1rem 1.4rem; font-size: clamp(1rem, 1.6vw, 1.15rem); line-height: 1.65; }
  .button-link { display: inline-flex; align-items: center; gap: 0.6rem; min-height: var(--button-height); padding: 0.65rem 1.1rem; border: 2px solid var(--teal-deep); border-radius: var(--control-radius); background: var(--teal-deep); color: var(--paper); font-size: var(--button-font-size); font-weight: 750; text-decoration: none; transition: background-color 140ms ease, color 140ms ease; }
  .button-link:hover { background: transparent; color: var(--teal-deep); }
  .hero-art { position: relative; width: min(100%, 500px); padding: 0.75rem; margin-inline: auto; border-radius: 48% 48% var(--card-radius) var(--card-radius); background: rgb(255 253 247 / 72%); }
  .hero-art img { display: block; width: 100%; height: auto; }
  .art-note { position: absolute; right: 0.25rem; bottom: 0.75rem; padding: 0.45rem 0.7rem; border: 1px solid rgb(215 168 51 / 30%); border-radius: 999px; background: var(--sun); color: var(--ink); font-size: 0.8rem; font-weight: 700; box-shadow: 0 4px 12px rgb(38 59 50 / 8%); }
  .section-shell { width: 100%; max-width: var(--site-content-width); padding-inline: var(--site-content-gutter); margin-inline: auto; }
  .featured-section, .reviews-section { padding-block: var(--section-block-space); }
  .reviews-section { padding-bottom: clamp(1.25rem, 2.4vw, 2rem); }
  .featured-section { border-top: 1px solid var(--line); }
  .section-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 0.8rem 1rem; margin-bottom: clamp(1rem, 2vw, 1.5rem); }
  .section-heading h2, .categories-section h2, .trust-section h2 { margin: 0; }
  .product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1rem; }
  .review-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .text-link { display: inline-flex; align-items: center; gap: 0.45rem; min-height: var(--button-height); padding: 0.55rem 0.8rem; border-radius: var(--control-radius); background: var(--sun); color: var(--teal-deep); font-size: var(--button-font-size); font-weight: 750; text-decoration: none; transition: background-color 140ms ease, color 140ms ease; }
  .text-link:hover { background: var(--teal-deep); color: var(--paper); }
  .featured-empty { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem 1.5rem; }
  .featured-empty > div { flex: 1 1 25rem; }
  .categories-section { padding-block: var(--section-block-space); background: var(--mist); }
  .category-grid { display: grid; grid-template-columns: 1fr; gap: 0.85rem; margin-top: 1.4rem; }
  .category-card { position: relative; display: grid; grid-template-columns: 2.5rem 1fr auto; align-items: center; gap: 0.8rem; min-height: 104px; padding: 1rem; border: 1px solid var(--line); border-radius: var(--card-radius); background: var(--paper); color: var(--ink); text-decoration: none; box-shadow: 0 4px 14px rgb(38 59 50 / 4%); transition: border-color 140ms ease, transform 140ms ease, box-shadow 140ms ease; }
  .category-card:hover { transform: translateY(-2px); border-color: var(--teal); box-shadow: var(--card-shadow); }
  .category-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 0.8rem; background: var(--mist); color: var(--teal-deep); }
  .category-icon svg { width: 1.45rem; fill: currentColor; }
  .category-number { position: absolute; top: 0.65rem; right: 0.75rem; color: #829589; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; }
  .category-copy strong, .category-copy small { display: block; }
  .category-copy strong { font-family: var(--heading-font); font-size: 1.1rem; }
  .category-copy small { margin-top: 0.15rem; color: var(--muted-ink); }
  .category-arrow { color: var(--teal); font-size: 1.2rem; }
  .trust-section { padding-block: var(--section-block-space); padding-top: clamp(1.25rem, 2.4vw, 2rem); }
  .trust-inner { display: grid; gap: 2rem; align-items: center; }
  .trust-section h2 { font-size: clamp(1.6rem, 3.2vw, 2.25rem); line-height: 1.25; }
  .trust-links { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  .trust-links p { margin: 0 0 0.35rem; color: var(--muted-ink); }
  .trust-links a { font-weight: 750; text-underline-offset: 4px; }
  @media (min-width: 700px) {
    .hero { grid-template-columns: 1.05fr 0.95fr; }
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .review-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-card { grid-template-columns: 2.5rem 1fr auto; gap: 0.75rem; padding: 1rem; }
    .trust-inner { grid-template-columns: 1.2fr 0.8fr; }
  }
  @media (min-width: 1000px) {
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .category-card { grid-template-columns: 2.5rem 1fr auto; gap: 0.85rem; padding: 1.15rem; }
  }
  @media (min-width: 1100px) {
    .review-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
  }
</style>
