---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const reviews = (await getCollection("reviews", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const feederReview = reviews.find((review) => review.id === "best-automatic-cat-feeders-2026");
const bestPicks = feederReview?.data.products.slice(0, 3) ?? [];
const categories = [
  { name: "Automatic cat feeders", slug: "automatic-cat-feeders", note: "Measured meals, easier routines" },
  { name: "Pet water fountains", slug: "pet-water-fountains", note: "Hydration gear, honestly compared" },
  { name: "Smart litter boxes", slug: "smart-litter-boxes", note: "What automation can—and can't—do" },
];
---

<SiteLayout
  title="AutoPet | Thoughtful reviews for smarter pet care"
  description="Independent, practical reviews of smart pet gadgets. Find the right automatic feeder and make a more confident choice for your cat."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Practical gear. Happier routines.</p>
      <h1>Better pet care, <span>one smart choice</span> at a time.</h1>
      <p class="intro">Honest, useful reviews for pet people who want the convenience without the guesswork. We look at what works in a real home—and what you can skip.</p>
      <a class="hero-link" href="/reviews/best-automatic-cat-feeders-2026/">Explore our feeder picks <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-art">
      <span class="art-note">Made for real-life routines</span>
      <img src="/images/feeder-illustration.svg" alt="Illustration of a cat beside an automatic feeder" width="520" height="420" fetchpriority="high" />
    </div>
  </section>

  <section class="section-shell best-picks" aria-labelledby="best-picks-heading">
    <div class="section-heading">
      <div><p class="eyebrow">A useful place to start</p><h2 id="best-picks-heading">Best picks for busy cat people</h2></div>
      <a href="/reviews/best-automatic-cat-feeders-2026/">See the full comparison <span aria-hidden="true">→</span></a>
    </div>
    {bestPicks.length > 0 ? (
      <div class="pick-list">
        {bestPicks.map((product, index) => (
          <article class="pick-band">
            <span class="pick-number">0{index + 1}</span>
            <div>
              <h3>{product.name}</h3>
              <p>{product.priceRange} · {product.features.join(" · ")}</p>
            </div>
            <a href={`/reviews/${feederReview?.id}/`}>See the comparison <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">Our recommended products will appear here soon.</p>
    )}
  </section>

  <section class="section-shell reviews-section" aria-labelledby="latest-heading">
    <div class="section-heading"><div><p class="eyebrow">Research without the noise</p><h2 id="latest-heading">Latest reviews</h2></div></div>
    {reviews.length > 0 ? (
      <div class="review-grid">
        {reviews.map((review) => (
          <article class="review-card">
            <p class="card-category">{review.data.category}</p>
            <h3><a href={`/reviews/${review.id}/`}>{review.data.title}</a></h3>
            <p>{review.data.description}</p>
            <time datetime={review.data.date.toISOString()}>{review.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
            <a class="text-link" href={`/reviews/${review.id}/`}>Read the review <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">We're working on our first reviews now. Please check back soon.</p>
    )}
  </section>

  <section class="categories-section" aria-labelledby="categories-heading">
    <div class="section-shell">
      <p class="eyebrow">Browse by need</p>
      <h2 id="categories-heading">Thoughtful tech for everyday pet care</h2>
      <div class="category-grid">
        {categories.map((category, index) => (
          <a class="category-link" href={`/category/${category.slug}/`}>
            <span class="category-number">0{index + 1}</span><span><strong>{category.name}</strong><small>{category.note}</small></span><span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { display: grid; align-items: center; gap: 1.5rem; width: min(1120px, calc(100% - 2rem)); margin: auto; padding-block: clamp(3rem, 8vw, 6.5rem); }
  .hero-copy { max-width: 620px; }
  .eyebrow { margin: 0 0 0.65rem; color: var(--teal); font-size: 0.95rem; font-weight: 750; letter-spacing: 0.035em; }
  h1 { max-width: 11ch; margin: 0; }
  h1 span { color: var(--teal); }
  .intro { margin-block: 1.2rem 1.5rem; color: var(--muted-ink); font-size: 1.1rem; }
  .hero-link, .text-link { font-weight: 750; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .hero-art { position: relative; }
  .hero-art img { display: block; width: 100%; height: auto; }
  .art-note { position: absolute; right: 0; bottom: 1rem; z-index: 1; padding: 0.55rem 0.8rem; background: var(--sun); color: var(--ink); font-size: 0.85rem; font-weight: 700; }
  .section-shell { width: min(1120px, calc(100% - 2rem)); margin-inline: auto; }
  .best-picks { padding-block: 2.7rem; border-top: 1px solid var(--line); }
  .section-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.4rem; }
  .section-heading h2, .categories-section h2 { margin: 0; }
  .section-heading > a { margin-bottom: 0.4rem; }
  .pick-band { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; padding: 1.3rem 0; border-bottom: 1px solid var(--line); }
  .pick-band:first-child { border-top: 1px solid var(--line); }
  .pick-number { color: var(--sun-deep); font-family: var(--heading-font); font-size: 2.2rem; font-weight: 800; }
  .pick-band h3 { margin: 0; font-size: 1.3rem; }
  .pick-band p { margin: 0.3rem 0 0; color: var(--muted-ink); }
  .pick-band > a { grid-column: 2; font-weight: 700; }
  .reviews-section { padding-block: 2.8rem; }
  .review-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .review-card { display: flex; flex-direction: column; min-height: 250px; padding: 1.35rem; background: var(--mist); border-bottom: 4px solid var(--teal); }
  .card-category { margin: 0; color: var(--teal); font-size: 0.86rem; font-weight: 750; }
  .review-card h3 { margin: 0.75rem 0 0.35rem; font-size: 1.45rem; }
  .review-card h3 a { color: var(--ink); text-decoration: none; }
  .review-card > p:not(.card-category) { margin-top: 0; color: var(--muted-ink); }
  .review-card time { margin-top: 0.4rem; color: var(--muted-ink); font-size: 0.9rem; }
  .review-card .text-link { margin-top: auto; }
  .empty-state { margin: 0; padding: 1.25rem; border-left: 4px solid var(--sun-deep); background: var(--mist); color: var(--muted-ink); }
  .categories-section { padding-block: 3.2rem; background: var(--mist); }
  .category-grid { margin-top: 1.5rem; border-top: 1px solid var(--line); }
  .category-link { display: grid; grid-template-columns: 2.5rem 1fr auto; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .category-number { color: var(--teal); font-family: var(--heading-font); font-weight: 800; }
  .category-link strong, .category-link small { display: block; }
  .category-link small { color: var(--muted-ink); }
  @media (min-width: 760px) { .hero { grid-template-columns: 1.05fr 0.95fr; } .review-grid { grid-template-columns: repeat(3, 1fr); } .pick-band { grid-template-columns: 3rem 1fr auto; align-items: center; } .pick-band > a { grid-column: auto; } }
</style>
