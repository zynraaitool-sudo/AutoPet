---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const reviews = (await getCollection("reviews", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestReviews = reviews.slice(0, 3);
const featuredProducts = reviews.flatMap((review) =>
  review.data.products.flatMap((product) => {
    if (!product.url || /REPLACE-WITH-AFFILIATE-LINK/i.test(product.url)) return [];
    return [{ ...product, url: product.url, review }];
  }),
);
const categories = [
  { name: "Automatic Cat Feeders", slug: "automatic-cat-feeders", note: "Thoughtful feeding routines, made simpler" },
  { name: "Pet Water Fountains", slug: "pet-water-fountains", note: "A clearer look at everyday hydration" },
  { name: "Smart Litter Boxes", slug: "smart-litter-boxes", note: "A practical guide to more convenient cleanup" },
];

const categoryTitle = (category: string) =>
  category.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
---

<SiteLayout
  title="AutoPet | Thoughtful reviews for smarter pet care"
  description="Independent, practical reviews of smart pet gadgets. Find the right automatic feeder and make a more confident choice for your cat."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Practical gear. Happier routines.</p>
      <h1>Better Pet Care Starts With <span>Smarter Choices.</span></h1>
      <p class="intro">Honest reviews and practical guides to help you choose better technology for your pets.</p>
      <a class="button-link" href="#featured-products">Explore Our Top Picks <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-art">
      <span class="art-note">Made for real-life routines</span>
      <img src="/images/feeder-illustration.svg" alt="Illustration of a cat beside an automatic feeder" width="520" height="420" fetchpriority="high" />
    </div>
  </section>

  <section class="section-shell featured-section" id="featured-products" aria-labelledby="featured-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Considered recommendations</p>
        <h2 id="featured-heading">Featured products</h2>
      </div>
      <p class="section-note">Selected from our published reviews</p>
    </div>
    {featuredProducts.length > 0 ? (
      <div class="product-grid">
        {featuredProducts.map(({ product, review }) => (
          <article class="product-card">
            {product.image || review.data.image ? (
              <img
                class="product-image"
                src={product.image ?? review.data.image}
                alt={product.image ? product.name : (review.data.imageAlt ?? review.data.title)}
                loading="lazy"
              />
            ) : (
              <div class="product-image-placeholder" aria-hidden="true">AutoPet</div>
            )}
            <div class="product-content">
              <p class="card-category">{categoryTitle(review.data.category)}</p>
              <h3>{product.name}</h3>
              <p class="product-description">{product.features.join(" · ")}</p>
              <a class="text-link" href={product.url} rel="sponsored nofollow noopener">
                Check current listing <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p class="empty-title">Our product shortlist is taking shape.</p>
        <p>As we publish reviews with verified product links, considered picks will appear here.</p>
      </div>
    )}
  </section>

  <section class="section-shell reviews-section" aria-labelledby="latest-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research without the noise</p>
        <h2 id="latest-heading">Latest reviews</h2>
      </div>
    </div>
    {latestReviews.length > 0 ? (
      <div class="review-grid">
        {latestReviews.map((review) => {
          const productImage = review.data.products.find((product) => product.image)?.image;
          const image = review.data.image ?? productImage ?? "/images/feeder-illustration.svg";
          const imageAlt = review.data.image
            ? (review.data.imageAlt ?? review.data.title)
            : productImage
              ? review.data.products.find((product) => product.image)?.name ?? review.data.title
              : "Illustration of a cat beside an automatic feeder";
          return (
            <article class="review-card">
              <a class="review-image-link" href={`/reviews/${review.id}/`} tabindex="-1" aria-hidden="true">
                <img src={image} alt={imageAlt} loading="lazy" />
              </a>
              <div class="review-content">
                <div class="review-meta">
                  <p class="card-category">{categoryTitle(review.data.category)}</p>
                  <time datetime={review.data.date.toISOString()}>
                    {review.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                  </time>
                </div>
                <h3><a href={`/reviews/${review.id}/`}>{review.data.title}</a></h3>
                <p class="review-description">{review.data.description}</p>
                <a class="text-link" href={`/reviews/${review.id}/`}>Read the review <span aria-hidden="true">→</span></a>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <p class="empty-title">Our first reviews are in the works.</p>
        <p>Check back soon for practical, carefully researched guides.</p>
      </div>
    )}
  </section>

  <section class="categories-section" aria-labelledby="categories-heading">
    <div class="section-shell">
      <p class="eyebrow">Browse by need</p>
      <h2 id="categories-heading">Thoughtful tech for everyday pet care</h2>
      <div class="category-grid">
        {categories.map((category, index) => (
          <a class="category-card" href={`/category/${category.slug}/`}>
            <span class="category-number">0{index + 1}</span>
            <span class="category-copy">
              <strong>{category.name}</strong>
              <small>{category.note}</small>
            </span>
            <span class="category-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="trust-section" aria-labelledby="trust-heading">
    <div class="section-shell trust-inner">
      <div>
        <p class="eyebrow">Our promise to you</p>
        <h2 id="trust-heading">Independent research.<br />Honest comparisons.<br />Practical recommendations.</h2>
      </div>
      <div class="trust-links">
        <p>Clear information helps you find the right fit for your home, your pet, and your routine.</p>
        <a href="/about/">How we work <span aria-hidden="true">→</span></a>
        <a href="/affiliate-disclosure/">Our affiliate disclosure <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { display: grid; align-items: center; gap: clamp(2rem, 5vw, 4.5rem); width: min(1160px, calc(100% - 2.5rem)); margin: auto; padding-block: clamp(3.5rem, 8vw, 7rem); }
  .hero-copy { max-width: 630px; }
  .eyebrow { margin: 0 0 0.7rem; color: var(--teal); font-size: 0.82rem; font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { max-width: 12ch; margin: 0; font-size: clamp(2.8rem, 7vw, 5.25rem); }
  h1 span { color: var(--teal); }
  .intro { max-width: 52ch; margin-block: 1.35rem 1.8rem; color: var(--muted-ink); font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.7; }
  .button-link { display: inline-flex; align-items: center; gap: 0.7rem; min-height: 3.2rem; padding: 0.75rem 1.2rem; border: 2px solid var(--teal-deep); border-radius: 0.25rem; background: var(--teal-deep); color: var(--paper); font-weight: 750; text-decoration: none; transition: background-color 140ms ease, color 140ms ease; }
  .button-link:hover { background: transparent; color: var(--teal-deep); }
  .hero-art { position: relative; max-width: 560px; margin-inline: auto; }
  .hero-art img { display: block; width: 100%; height: auto; }
  .art-note { position: absolute; right: 0; bottom: 1rem; padding: 0.55rem 0.8rem; background: var(--sun); color: var(--ink); font-size: 0.85rem; font-weight: 700; }
  .section-shell { width: min(1160px, calc(100% - 2.5rem)); margin-inline: auto; }
  .featured-section, .reviews-section { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .featured-section { border-top: 1px solid var(--line); }
  .section-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.65rem; }
  .section-heading h2, .categories-section h2, .trust-section h2 { margin: 0; }
  .section-note { margin: 0 0 0.25rem; color: var(--muted-ink); font-size: 0.94rem; }
  .product-grid { display: grid; grid-template-columns: 1fr; gap: 1.2rem; }
  .product-card { overflow: hidden; border: 1px solid var(--line); border-radius: 0.35rem; background: var(--paper); box-shadow: 0 8px 26px rgb(23 53 55 / 6%); }
  .product-image, .product-image-placeholder { display: grid; width: 100%; height: 230px; object-fit: contain; background: var(--mist); }
  .product-image-placeholder { place-items: center; color: var(--teal); font-family: var(--heading-font); font-size: 1.3rem; font-weight: 800; }
  .product-content { display: flex; min-height: 225px; flex-direction: column; align-items: flex-start; padding: 1.35rem; }
  .card-category { margin: 0; color: var(--teal); font-size: 0.78rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; }
  .product-card h3 { margin: 0.5rem 0 0.35rem; font-size: 1.35rem; }
  .product-description { margin: 0 0 1.1rem; color: var(--muted-ink); font-size: 0.94rem; }
  .text-link { margin-top: auto; color: var(--teal-deep); font-weight: 750; text-underline-offset: 4px; }
  .empty-state { padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--line); border-left: 5px solid var(--sun-deep); border-radius: 0.2rem; background: var(--mist); color: var(--muted-ink); }
  .empty-state p { margin: 0; }
  .empty-state .empty-title { margin-bottom: 0.35rem; color: var(--ink); font-family: var(--heading-font); font-size: 1.25rem; font-weight: 750; }
  .review-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  .review-card { overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 0.35rem; background: var(--paper); }
  .review-image-link { display: block; overflow: hidden; height: 230px; background: var(--mist); }
  .review-image-link img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 180ms ease; }
  .review-card:hover .review-image-link img { transform: scale(1.025); }
  .review-content { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 1.3rem; }
  .review-meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.4rem 0.8rem; width: 100%; }
  .review-meta time { color: var(--muted-ink); font-size: 0.82rem; }
  .review-card h3 { margin: 0.8rem 0 0.5rem; font-size: 1.35rem; }
  .review-card h3 a { color: var(--ink); text-decoration: none; text-decoration-color: var(--teal); text-underline-offset: 4px; }
  .review-card h3 a:hover { color: var(--teal); text-decoration: underline; }
  .review-description { margin: 0 0 1.25rem; color: var(--muted-ink); }
  .categories-section { padding-block: clamp(3rem, 7vw, 5rem); background: var(--mist); }
  .category-grid { display: grid; grid-template-columns: 1fr; gap: 0.8rem; margin-top: 1.6rem; }
  .category-card { display: grid; grid-template-columns: 2.7rem 1fr auto; align-items: center; gap: 1rem; min-height: 100px; padding: 1.15rem; border: 1px solid var(--line); border-radius: 0.3rem; background: var(--paper); color: var(--ink); text-decoration: none; transition: border-color 140ms ease, transform 140ms ease; }
  .category-card:hover { transform: translateY(-2px); border-color: var(--teal); }
  .category-number { color: var(--teal); font-family: var(--heading-font); font-size: 1.45rem; font-weight: 800; }
  .category-copy strong, .category-copy small { display: block; }
  .category-copy strong { font-family: var(--heading-font); font-size: 1.1rem; }
  .category-copy small { margin-top: 0.15rem; color: var(--muted-ink); }
  .category-arrow { color: var(--teal); font-size: 1.2rem; }
  .trust-section { padding-block: clamp(3rem, 7vw, 5rem); }
  .trust-inner { display: grid; gap: 2rem; align-items: center; }
  .trust-section h2 { font-size: clamp(1.8rem, 4vw, 2.7rem); line-height: 1.28; }
  .trust-links { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  .trust-links p { margin: 0 0 0.35rem; color: var(--muted-ink); }
  .trust-links a { font-weight: 750; text-underline-offset: 4px; }
  @media (min-width: 700px) {
    .hero { grid-template-columns: 1.05fr 0.95fr; }
    .product-grid, .review-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .category-card { grid-template-columns: 2rem 1fr auto; gap: 0.7rem; padding: 1rem; }
    .trust-inner { grid-template-columns: 1.2fr 0.8fr; }
  }
  @media (min-width: 1000px) {
    .product-grid, .review-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .category-card { grid-template-columns: 2.7rem 1fr auto; gap: 1rem; padding: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
  }
</style>
