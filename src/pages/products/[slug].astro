---
import { getCollection, render } from "astro:content";
import ProductCard from "../../components/ProductCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { isSafeMp4Url, youtubeVideoId } from "../../lib/media";
import ArticleCard from "../../components/ArticleCard.astro";
import { categoryLabels } from "../../lib/category-labels";

export async function getStaticPaths() {
  const products = await getCollection("products", ({ data }) => !data.draft);
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const {
  name, category, seoTitle, description, image, imageAlt, gallery, youtubeUrl, videoUrl,
  videoPoster, videoTitle, specifications, features, pros, cons, price, affiliateUrl,
  productUrl, relatedArticle, catalogVisible,
} = product.data;
const purchaseUrl = affiliateUrl ?? productUrl;
const categoryTitle = categoryLabels[category]?.title ?? category.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
const categoryHref = `/category/${category}/`;
const canonical = new URL(`/products/${product.id}/`, Astro.site).href;
const galleryImages = [...new Set([...(image ? [image] : []), ...gallery])];
const videoId = youtubeUrl ? youtubeVideoId(youtubeUrl) : undefined;
const mp4Url = videoUrl && isSafeMp4Url(videoUrl) ? videoUrl : undefined;
const relatedProducts = (await getCollection("products", ({ data }) => !data.draft))
  .filter((entry) => entry.id !== product.id && entry.data.category === category)
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder || a.data.name.localeCompare(b.data.name))
  .slice(0, 3);
const relatedGuides = (await getCollection("reviews", ({ data }) => !data.draft && data.category === category))
  .sort((a, b) => {
    if (a.id === relatedArticle) return -1;
    if (b.id === relatedArticle) return 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 3);
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  description,
  ...(galleryImages.length > 0
    ? { image: galleryImages.map((src) => new URL(src, Astro.site).href) }
    : {}),
  url: canonical,
  category: categoryTitle,
};
---

<SiteLayout
  title={seoTitle ?? `${name} | AutoPet`}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={imageAlt ?? name}
>
  <article class="page-shell product-page">
    <a class="back-link" href="/products/">← Browse products</a>
    <header class="product-header">
      <p class="eyebrow"><a href={categoryHref}>{categoryTitle}</a></p>
      <h1>{name}</h1>
      <p class="intro">{description}</p>
      {!catalogVisible && (
        <p class="catalog-note">This page is kept for reference and is not included in AutoPet's curated pet-care recommendations.</p>
      )}
      {price && <p class="price">{price}</p>}
      {purchaseUrl && (
        <>
          <a class="buy-button" href={purchaseUrl} rel={affiliateUrl ? "sponsored nofollow noopener" : "nofollow noopener"} target="_blank">
            View on AliExpress <span aria-hidden="true">↗</span>
          </a>
          {affiliateUrl ? (
            <p class="affiliate-note">Affiliate link: AutoPet may earn a commission at no extra cost to you. <a href="/affiliate-disclosure/">Disclosure details</a>.</p>
          ) : (
            <p class="affiliate-note">This is a direct product link, not an affiliate link. Listing details and availability may change.</p>
          )}
        </>
      )}
    </header>

    {galleryImages.length > 0 && (
      <section class="gallery-section" aria-label="Product images">
        <div class="gallery-main">
          <img id="gallery-main-image" src={galleryImages[0]} alt={imageAlt ?? name} />
        </div>
        {galleryImages.length > 1 && (
          <div class="gallery-thumbnails" aria-label="Choose a product image">
            {galleryImages.map((src, index) => (
              <button
                type="button"
                class:list={["thumbnail", { selected: index === 0 }]}
                data-src={src}
                data-alt={`${name} image ${index + 1}`}
                aria-label={`Show product image ${index + 1}`}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <img src={src} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </section>
    )}

    <section class="related-guides" aria-labelledby="related-guides-heading">
      <h2 id="related-guides-heading">Related Buying Guides</h2>
      {relatedGuides.length > 0 ? (
        <div class="guide-grid">
          {relatedGuides.map((guide) => <ArticleCard article={guide} />)}
        </div>
      ) : (
        <p class="no-guides">No buying guides are published in this category yet. <a href="/reviews/">Browse all reviews and guides</a>.</p>
      )}
    </section>

    {(videoId || mp4Url) && (
      <section class="video-section">
        <h2>{videoTitle ?? "Product video"}</h2>
        {videoId ? (
          <div class="video-frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${videoId}`}
              title={videoTitle ?? `${name} video`}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        ) : mp4Url ? (
          <video controls preload="metadata" poster={videoPoster} aria-label={videoTitle ?? `${name} video`}>
            <source src={mp4Url} type="video/mp4" />
            Your browser does not support HTML video.
          </video>
        ) : null}
      </section>
    )}

    <div class="product-details">
      {product.body && <section class="prose"><Content /></section>}

      {specifications.length > 0 && (
        <section>
          <h2>Specifications</h2>
          <dl class="spec-list">
            {specifications.map((spec) => <div><dt>{spec.name}</dt><dd>{spec.value}</dd></div>)}
          </dl>
        </section>
      )}

      {features.length > 0 && (
        <section>
          <h2>Features</h2>
          <ul>{features.map((feature) => <li>{feature}</li>)}</ul>
        </section>
      )}

      {(pros.length > 0 || cons.length > 0) && (
        <section>
          <h2>Pros and cons</h2>
          <div class="pros-cons">
            {pros.length > 0 && <div><h3>Pros</h3><ul>{pros.map((pro) => <li>{pro}</li>)}</ul></div>}
            {cons.length > 0 && <div><h3>Cons</h3><ul>{cons.map((con) => <li>{con}</li>)}</ul></div>}
          </div>
        </section>
      )}

    </div>

    {relatedProducts.length > 0 && (
      <section class="related-products" aria-labelledby="related-products-heading">
        <h2 id="related-products-heading">Related products</h2>
        <div class="product-grid">
          {relatedProducts.map((related) => <ProductCard product={related} />)}
        </div>
      </section>
    )}
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
</SiteLayout>

{galleryImages.length > 1 && (
  <script>
    const mainImage = document.querySelector<HTMLImageElement>("#gallery-main-image");
    const thumbnails = document.querySelectorAll<HTMLButtonElement>(".thumbnail");

    if (mainImage) {
      thumbnails.forEach((thumbnail) => {
        thumbnail.addEventListener("click", () => {
          const src = thumbnail.dataset.src;
          if (!src) return;
          mainImage.src = src;
          mainImage.alt = thumbnail.dataset.alt ?? "";
          thumbnails.forEach((button) => {
            const selected = button === thumbnail;
            button.classList.toggle("selected", selected);
            button.setAttribute("aria-pressed", String(selected));
          });
        });
      });
    }
  </script>
)}

<style>
  .back-link { font-size: 0.9rem; font-weight: 700; }
  .product-header { max-width: 780px; padding: clamp(1.25rem, 3vw, 2rem); margin: 1.5rem auto; border: 1px solid var(--line); border-radius: var(--card-radius); background: linear-gradient(135deg, var(--paper), #f2f4eb); }
  .eyebrow a { color: inherit; }
  h1 { margin: 0; font-size: clamp(2.15rem, 4.7vw, 3.55rem); overflow-wrap: anywhere; }
  .intro { font-size: clamp(1rem, 1.5vw, 1.12rem); }
  .price { color: var(--ink); font-size: 1.1rem; font-weight: 750; }
  .catalog-note { padding: 0.75rem 1rem; border-left: 4px solid var(--sun-deep); background: var(--mist); color: var(--muted-ink); }
  .buy-button { display: inline-flex; align-items: center; gap: 0.55rem; min-height: var(--button-height); padding: 0.55rem 0.9rem; border-radius: var(--control-radius); background: var(--sun); color: var(--teal-deep); font-size: var(--button-font-size); font-weight: 750; text-decoration: none; }
  .buy-button:hover { background: var(--teal-deep); color: var(--paper); }
  .affiliate-note { margin: 0.6rem 0 0; color: var(--muted-ink); font-size: 0.84rem; }
  .gallery-section { max-width: 900px; margin: 1.5rem auto 2.25rem; }
  .gallery-main { overflow: hidden; width: 100%; aspect-ratio: 16 / 10; border: 1px solid var(--line); border-radius: var(--card-radius); background: linear-gradient(145deg, var(--mist), #f7f4e8); }
  .gallery-main img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .gallery-thumbnails { display: flex; gap: 0.75rem; overflow-x: auto; padding: 0.75rem 0.1rem; }
  .thumbnail { flex: 0 0 5rem; overflow: hidden; width: 5rem; aspect-ratio: 1; padding: 0; border: 2px solid transparent; border-radius: var(--control-radius); background: var(--mist); cursor: pointer; }
  .thumbnail.selected { border-color: var(--teal); }
  .thumbnail img { width: 100%; height: 100%; object-fit: cover; }
  .video-section { max-width: 850px; margin: 2rem auto; }
  .video-frame { position: relative; overflow: hidden; width: 100%; aspect-ratio: 16 / 9; background: var(--ink); }
  .video-frame iframe, video { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }
  .video-frame iframe { position: absolute; inset: 0; height: 100%; }
  video { max-height: 70vh; background: var(--ink); }
  .product-details { max-width: 850px; margin: 2.25rem auto; }
  .product-details section { margin-top: 2rem; }
  .product-details h2, .related-products h2 { margin-bottom: 0.85rem; }
  .product-details h3 { margin-bottom: 0.5rem; }
  .product-details li { margin-block: 0.35rem; color: var(--muted-ink); }
  .spec-list { margin: 0; border-top: 1px solid var(--line); }
  .spec-list div { display: grid; grid-template-columns: minmax(8rem, 1fr) 2fr; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
  .spec-list dt { font-weight: 750; }
  .spec-list dd { margin: 0; color: var(--muted-ink); }
  .pros-cons { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  .prose :global(p), .prose :global(li) { color: var(--muted-ink); }
  .prose :global(h2) { margin-top: 2.4rem; }
  .related-products { margin-top: 3rem; }
  .related-guides { margin-top: 3rem; }
  .related-guides h2 { margin-bottom: 0.85rem; }
  .no-guides { color: var(--muted-ink); }
  .product-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .guide-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 700px) {
    .pros-cons { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .product-page { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; column-gap: clamp(1.5rem, 4vw, 3rem); }
    .back-link, .video-section, .product-details, .related-products, .related-guides { grid-column: 1 / -1; }
    .back-link { grid-row: 1; }
    .product-header { grid-column: 2; grid-row: 2; align-self: center; margin: 0; }
    .gallery-section { grid-column: 1; grid-row: 2; width: 100%; max-width: none; margin: 0; }
    .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .guide-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
