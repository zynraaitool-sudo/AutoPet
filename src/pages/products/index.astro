---
import { getCollection } from "astro:content";
import ProductCard from "../../components/ProductCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const products = (await getCollection("products", ({ data }) => !data.draft && data.catalogVisible))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder || a.data.name.localeCompare(b.data.name));
const categories = [...new Set(products.map((product) => product.data.category))]
  .sort((a, b) => a.localeCompare(b));
const categoryTitle = (category: string) =>
  category.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
const canonical = new URL("/products/", Astro.site).href;
---

<SiteLayout
  title="Browse Pet Products | AutoPet"
  description="Explore AutoPet's curated catalog of pet products, compare categories, and find detailed product information."
  canonical={canonical}
  image="/images/feeder-illustration.svg"
>
  <section class="page-shell catalog">
    <header class="page-heading">
      <p class="eyebrow">Considered recommendations</p>
      <h1>Browse products</h1>
      <p class="intro">Explore our published product picks and open any item for its full details, specifications, and buying links.</p>
    </header>

    {products.length > 0 && (
      <>
        <div class="catalog-tools" aria-label="Product catalog controls">
          <label>
            <span>Search products</span>
            <input id="product-search" type="search" placeholder="Search by name" autocomplete="off" />
          </label>
          <label>
            <span>Category</span>
            <select id="product-category">
              <option value="">All categories</option>
              {categories.map((category) => <option value={category}>{categoryTitle(category)}</option>)}
            </select>
          </label>
          <label>
            <span>Sort by</span>
            <select id="product-sort">
              <option value="featured">Featured order</option>
              <option value="name-asc">Name: A to Z</option>
              <option value="name-desc">Name: Z to A</option>
              <option value="category">Category</option>
            </select>
          </label>
        </div>

        <p class="results-count" id="product-results" role="status">{products.length} {products.length === 1 ? "product" : "products"}</p>
      </>
    )}
    {products.length > 0 ? (
      <div class="product-grid" id="product-grid">
        {products.map((product) => (
          <div
            class="product-grid-item"
            data-name={product.data.name.toLowerCase()}
            data-category={product.data.category}
          >
            <ProductCard product={product} />
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state" id="product-empty">
        <p class="empty-kicker">Thoughtful picks, never guesswork</p>
        <h2>Our product catalog is coming soon.</h2>
        <p>We're carefully reviewing pet products before recommending them. Check back for published picks.</p>
      </div>
    )}
    {products.length > 0 && (
      <div class="empty-state filtered-empty" id="filtered-empty" hidden>
        <h2>No products match those filters.</h2>
        <p>Try a different search or category.</p>
      </div>
    )}
  </section>
</SiteLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#product-search");
  const category = document.querySelector<HTMLSelectElement>("#product-category");
  const sort = document.querySelector<HTMLSelectElement>("#product-sort");
  const grid = document.querySelector<HTMLElement>("#product-grid");
  const count = document.querySelector<HTMLElement>("#product-results");
  const empty = document.querySelector<HTMLElement>("#filtered-empty");

  if (search && category && sort && grid && count && empty) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>(".product-grid-item"));
    const filterProducts = () => {
      const query = search.value.trim().toLocaleLowerCase();
      const selectedCategory = category.value;
      const visible = items.filter((item) => {
        const matches = item.dataset.name?.includes(query) &&
          (!selectedCategory || item.dataset.category === selectedCategory);
        item.hidden = !matches;
        return matches;
      });

      const ordered = sort.value === "featured"
        ? items
        : [...items].sort((a, b) => {
          const aName = a.dataset.name ?? "";
          const bName = b.dataset.name ?? "";
          if (sort.value === "name-asc") return aName.localeCompare(bName);
          if (sort.value === "name-desc") return bName.localeCompare(aName);
          return (a.dataset.category ?? "").localeCompare(b.dataset.category ?? "") ||
            aName.localeCompare(bName);
        });
      ordered.forEach((item) => grid.append(item));

      empty.hidden = visible.length > 0;
      count.textContent = `${visible.length} ${visible.length === 1 ? "product" : "products"}`;
    };

    search.addEventListener("input", filterProducts);
    category.addEventListener("change", filterProducts);
    sort.addEventListener("change", filterProducts);
  }
</script>

<style>
  .catalog-tools { display: grid; grid-template-columns: 1fr; gap: 0.8rem; margin-block: 1.5rem 0.8rem; }
  label { display: grid; gap: 0.35rem; color: var(--ink); font-size: 0.9rem; font-weight: 700; }
  input, select { width: 100%; }
  .results-count { margin: 0 0 1rem; color: var(--muted-ink); font-size: 0.9rem; }
  .product-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .product-grid-item { min-width: 0; }
  .product-grid-item[hidden] { display: none; }
  @media (min-width: 640px) { .catalog-tools { grid-template-columns: 2fr 1.2fr 1.2fr; } }
  @media (min-width: 700px) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
