---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Contact AutoPet" description="Contact AutoPet with a question, correction, or suggestion about our pet product guides.">
  <article class="page">
    <p class="eyebrow">We'd like to hear from you</p>
    <h1>Contact AutoPet</h1>
    <p>Have a correction, a question about a guide, or an idea for a future review? Send us an email and include the page you're writing about.</p>
    <p><a class="email-link" href="mailto:hello@autopet.store">hello@autopet.store</a></p>
  </article>
</SiteLayout>
<style>
  .page { width: min(760px, calc(100% - 2rem)); margin: auto; padding-block: 3rem; }
  .eyebrow { color: var(--teal); font-weight: 750; }
  .email-link { display: inline-block; padding: 0.7rem 1rem; background: var(--sun); color: var(--ink); font-weight: 750; }
</style>
